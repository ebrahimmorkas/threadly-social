# ---------------------------------------------------------------------------
# Threadly environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Public URL of the app (used for metadata and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (docker compose exposes this by default)
DATABASE_URL=postgres://threadly:threadly@localhost:5433/threadly

# --- Optional services -----------------------------------------------------

# Redis is OPTIONAL. When set, it is used for caching, rate limiting and for
# fanning out real-time notifications across multiple app instances (pub/sub).
# When empty, the app uses in-memory implementations (single instance).
REDIS_URL=
# REDIS_URL=redis://localhost:6380
